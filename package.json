{
  "name": "connected-solar-advisor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "python3 -m http.server 3000 --bind 0.0.0.0",
    "test": "node --test",
    "test:ocr": "npm run build && node scripts/check-bill-import.mjs",
    "test:progress": "npm run build && node scripts/check-progress.mjs",
    "test:guidance": "npm run build && node scripts/check-guidance.mjs",
    "test:questionnaire": "npm run build && node scripts/check-questionnaire.mjs",
    "test:simplified": "npm run build && node scripts/check-simplified.mjs",
    "test:referrals": "npm run build && node scripts/check-referrals.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "playwright": "1.65.1",
    "tesseract.js": "6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
